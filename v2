# ============================================================
# GENERAL HELPER FUNCTIONS
# ============================================================

def utc_text(value):
    if value is None:
        return None

    if value.tzinfo is None:
        value = value.replace(
            tzinfo=timezone.utc
        )

    return value.astimezone(
        timezone.utc
    ).isoformat()


def empty_record(
    snapshot_time,
    account_id,
    account_name,
    region,
    error=None
):
    return {
        "snapshot_time": snapshot_time,
        "account_id": account_id,
        "account_name": account_name,
        "region": region,
        "key_id": None,
        "key_arn": None,
        "aliases": [],
        "primary_alias": None,
        "description": None,
        "key_state": None,
        "key_manager": None,
        "key_spec": None,
        "key_usage": None,
        "origin": None,
        "creation_date": None,
        "deletion_date": None,
        "enabled": None,
        "multi_region": None,
        "pending_deletion": None,
        "tags": {},
        "rotation_supported": None,
        "rotation_enabled": None,
        "rotation_period_days": None,
        "next_rotation_date": None,
        "collection_error": error
    }


def append_error(record, message):
    current_error = record.get(
        "collection_error"
    )

    if current_error:
        record["collection_error"] = (
            current_error
            + "; "
            + message
        )
    else:
        record["collection_error"] = message


# ============================================================
# CROSS-ACCOUNT ACCESS
# ============================================================

def assume_member_role(account_id):
    role_arn = (
        "arn:aws:iam::"
        + account_id
        + ":role/"
        + MEMBER_ROLE_NAME
    )

    request = {
        "RoleArn": role_arn,
        "RoleSessionName": (
            "KMSInventoryCollector"
        ),
        "DurationSeconds": 3600
    }

    if EXTERNAL_ID:
        request["ExternalId"] = EXTERNAL_ID

    response = STS.assume_role(
        **request
    )

    credentials = response[
        "Credentials"
    ]

    LOGGER.info(
        "AssumeRole successful: %s",
        role_arn
    )

    return {
        "aws_access_key_id": credentials[
            "AccessKeyId"
        ],
        "aws_secret_access_key": credentials[
            "SecretAccessKey"
        ],
        "aws_session_token": credentials[
            "SessionToken"
        ]
    }


def assumed_client(
    service_name,
    region,
    credentials
):
    return boto3.client(
        service_name,
        region_name=region,
        aws_access_key_id=credentials[
            "aws_access_key_id"
        ],
        aws_secret_access_key=credentials[
            "aws_secret_access_key"
        ],
        aws_session_token=credentials[
            "aws_session_token"
        ],
        config=AWS_CONFIG
    )


# ============================================================
# REGION DISCOVERY
# ============================================================

def enabled_regions(credentials):
    ec2_client = assumed_client(
        service_name="ec2",
        region="us-east-1",
        credentials=credentials
    )

    response = ec2_client.describe_regions(
        AllRegions=False
    )

    regions = []

    for item in response.get(
        "Regions",
        []
    ):
        region_name = item.get(
            "RegionName"
        )

        if region_name:
            regions.append(
                region_name
            )

    return sorted(regions)


# ============================================================
# KMS ALIAS AND KEY FUNCTIONS
# ============================================================

def build_alias_map(kms_client):
    result = {}

    paginator = kms_client.get_paginator(
        "list_aliases"
    )

    for page in paginator.paginate():
        for item in page.get(
            "Aliases",
            []
        ):
            key_id = item.get(
                "TargetKeyId"
            )

            alias_name = item.get(
                "AliasName"
            )

            if key_id and alias_name:
                result.setdefault(
                    key_id,
                    []
                ).append(
                    alias_name
                )

    final_result = {}

    for key_id, alias_list in result.items():
        final_result[key_id] = sorted(
            set(alias_list)
        )

    return final_result


def list_all_keys(kms_client):
    result = []

    paginator = kms_client.get_paginator(
        "list_keys"
    )

    for page in paginator.paginate():
        result.extend(
            page.get(
                "Keys",
                []
            )
        )

    return result


# ============================================================
# KMS TAG COLLECTION
# ============================================================

def get_key_tags(kms_client, key_id):
    tags = {}
    marker = None

    while True:
        request = {
            "KeyId": key_id,
            "Limit": 50
        }

        if marker:
            request["Marker"] = marker

        response = (
            kms_client.list_resource_tags(
                **request
            )
        )

        for item in response.get(
            "Tags",
            []
        ):
            tag_key = item.get(
                "TagKey"
            )

            tag_value = item.get(
                "TagValue",
                ""
            )

            if tag_key:
                tags[tag_key] = tag_value

        if not response.get(
            "Truncated"
        ):
            break

        marker = response.get(
            "NextMarker"
        )

        if not marker:
            break

    return tags


# ============================================================
# KMS ROTATION COLLECTION
# ============================================================

def get_rotation_details(
    kms_client,
    key_id,
    metadata
):
    rotation_supported = (
        metadata.get("KeySpec")
        == "SYMMETRIC_DEFAULT"
        and metadata.get("KeyUsage")
        == "ENCRYPT_DECRYPT"
        and metadata.get("Origin")
        == "AWS_KMS"
    )

    if not rotation_supported:
        return {
            "rotation_supported": False,
            "rotation_enabled": None,
            "rotation_period_days": None,
            "next_rotation_date": None,
            "rotation_error": None
        }

    if (
        metadata.get("KeyState")
        == "PendingDeletion"
    ):
        return {
            "rotation_supported": True,
            "rotation_enabled": False,
            "rotation_period_days": None,
            "next_rotation_date": None,
            "rotation_error": None
        }

    try:
        response = (
            kms_client.get_key_rotation_status(
                KeyId=key_id
            )
        )

        return {
            "rotation_supported": True,
            "rotation_enabled": response.get(
                "KeyRotationEnabled"
            ),
            "rotation_period_days": response.get(
                "RotationPeriodInDays"
            ),
            "next_rotation_date": utc_text(
                response.get(
                    "NextRotationDate"
                )
            ),
            "rotation_error": None
        }

    except ClientError as error:
        error_code = (
            error.response
            .get("Error", {})
            .get("Code", "Unknown")
        )

        if error_code in {
            "UnsupportedOperationException",
            "KMSInvalidStateException"
        }:
            return {
                "rotation_supported": False,
                "rotation_enabled": None,
                "rotation_period_days": None,
                "next_rotation_date": None,
                "rotation_error": None
            }

        return {
            "rotation_supported": True,
            "rotation_enabled": None,
            "rotation_period_days": None,
            "next_rotation_date": None,
            "rotation_error": (
                error_code
                + ": "
                + str(error)
            )
        }


# ============================================================
# INDIVIDUAL KEY COLLECTION
# ============================================================

def collect_key(
    kms_client,
    snapshot_time,
    account_id,
    account_name,
    region,
    key_id,
    aliases
):
    record = empty_record(
        snapshot_time=snapshot_time,
        account_id=account_id,
        account_name=account_name,
        region=region
    )

    record["key_id"] = key_id
    record["aliases"] = aliases

    record["primary_alias"] = (
        aliases[0]
        if aliases
        else None
    )

    try:
        response = kms_client.describe_key(
            KeyId=key_id
        )

        metadata = response[
            "KeyMetadata"
        ]

        record.update({
            "key_id": metadata.get(
                "KeyId",
                key_id
            ),
            "key_arn": metadata.get(
                "Arn"
            ),
            "description": metadata.get(
                "Description",
                ""
            ),
            "key_state": metadata.get(
                "KeyState"
            ),
            "key_manager": metadata.get(
                "KeyManager"
            ),
            "key_spec": metadata.get(
                "KeySpec"
            ),
            "key_usage": metadata.get(
                "KeyUsage"
            ),
            "origin": metadata.get(
                "Origin"
            ),
            "creation_date": utc_text(
                metadata.get(
                    "CreationDate"
                )
            ),
            "deletion_date": utc_text(
                metadata.get(
                    "DeletionDate"
                )
            ),
            "enabled": metadata.get(
                "Enabled"
            ),
            "multi_region": metadata.get(
                "MultiRegion",
                False
            ),
            "pending_deletion": (
                metadata.get("KeyState")
                == "PendingDeletion"
            )
        })

        try:
            record["tags"] = (
                get_key_tags(
                    kms_client,
                    key_id
                )
            )

        except ClientError as error:
            record["tags"] = {}

            append_error(
                record,
                "ListResourceTags failed: "
                + str(error)
            )

        rotation = get_rotation_details(
            kms_client=kms_client,
            key_id=key_id,
            metadata=metadata
        )

        record.update({
            "rotation_supported": rotation[
                "rotation_supported"
            ],
            "rotation_enabled": rotation[
                "rotation_enabled"
            ],
            "rotation_period_days": rotation[
                "rotation_period_days"
            ],
            "next_rotation_date": rotation[
                "next_rotation_date"
            ]
        })

        if rotation["rotation_error"]:
            append_error(
                record,
                rotation["rotation_error"]
            )

    except (
        ClientError,
        BotoCoreError
    ) as error:
        append_error(
            record,
            "DescribeKey failed: "
            + str(error)
        )

    return record


# ============================================================
# ACCOUNT INVENTORY COLLECTION
# ============================================================

def collect_account(
    snapshot_time,
    account
):
    account_id = account[
        "account_id"
    ]

    account_name = account[
        "account_name"
    ]

    try:
        credentials = assume_member_role(
            account_id
        )

    except (
        ClientError,
        BotoCoreError
    ) as error:
        return [
            empty_record(
                snapshot_time=snapshot_time,
                account_id=account_id,
                account_name=account_name,
                region=None,
                error=(
                    "AssumeRole failed: "
                    + str(error)
                )
            )
        ]

    try:
        regions = enabled_regions(
            credentials
        )

    except (
        ClientError,
        BotoCoreError
    ) as error:
        return [
            empty_record(
                snapshot_time=snapshot_time,
                account_id=account_id,
                account_name=account_name,
                region=None,
                error=(
                    "DescribeRegions failed: "
                    + str(error)
                )
            )
        ]

    account_records = []

    for region in regions:
        LOGGER.info(
            "Collecting account=%s region=%s",
            account_id,
            region
        )

        try:
            kms_client = assumed_client(
                service_name="kms",
                region=region,
                credentials=credentials
            )

            aliases_by_key = build_alias_map(
                kms_client
            )

            keys = list_all_keys(
                kms_client
            )

            for item in keys:
                key_id = item[
                    "KeyId"
                ]

                key_record = collect_key(
                    kms_client=kms_client,
                    snapshot_time=snapshot_time,
                    account_id=account_id,
                    account_name=account_name,
                    region=region,
                    key_id=key_id,
                    aliases=aliases_by_key.get(
                        key_id,
                        []
                    )
                )

                account_records.append(
                    key_record
                )

        except (
            ClientError,
            BotoCoreError
        ) as error:
            account_records.append(
                empty_record(
                    snapshot_time=snapshot_time,
                    account_id=account_id,
                    account_name=account_name,
                    region=region,
                    error=(
                        "Region collection failed: "
                        + str(error)
                    )
                )
            )

    return account_records


# ============================================================
# NDJSON AND S3 OUTPUT
# ============================================================

def convert_to_ndjson(records):
    lines = []

    for record in records:
        lines.append(
            json.dumps(
                record,
                separators=(",", ":"),
                ensure_ascii=False,
                default=str
            )
        )

    return "\n".join(lines) + "\n"


def write_inventory(
    records,
    collection_time
):
    body = convert_to_ndjson(
        records
    ).encode("utf-8")

    history_key = (
        "history/"
        + "year="
        + collection_time.strftime("%Y")
        + "/month="
        + collection_time.strftime("%m")
        + "/day="
        + collection_time.strftime("%d")
        + "/kms-inventory-"
        + collection_time.strftime(
            "%Y%m%dT%H%M%SZ"
        )
        + ".json"
    )

    common_parameters = {
        "Bucket": CENTRAL_BUCKET,
        "Body": body,
        "ContentType": (
            "application/x-ndjson"
        ),
        "ServerSideEncryption": "AES256"
    }

    S3.put_object(
        Key=CURRENT_OBJECT_KEY,
        **common_parameters
    )

    S3.put_object(
        Key=history_key,
        **common_parameters
    )

    return history_key


# ============================================================
# LAMBDA HANDLER
# ============================================================

def lambda_handler(event, context):
    collection_time = datetime.now(
        timezone.utc
    )

    snapshot_time = utc_text(
        collection_time
    )

    # Validate the configured AWS Account IDs.
    for account in TARGET_ACCOUNTS:
        account_id = account.get(
            "account_id",
            ""
        )

        if (
            not account_id.isdigit()
            or len(account_id) != 12
        ):
            raise ValueError(
                "Replace "
                "REPLACE_WITH_12_DIGIT_ACCOUNT_ID "
                "with a real 12-digit AWS "
                "Account ID."
            )

    all_records = []
    account_summaries = []

    for account in TARGET_ACCOUNTS:
        account_records = collect_account(
            snapshot_time=snapshot_time,
            account=account
        )

        all_records.extend(
            account_records
        )

        error_count = sum(
            1
            for item in account_records
            if item.get(
                "collection_error"
            )
        )

        account_summaries.append({
            "account_id": account[
                "account_id"
            ],
            "account_name": account[
                "account_name"
            ],
            "record_count": len(
                account_records
            ),
            "error_count": error_count
        })

    if not all_records:
        raise RuntimeError(
            "No inventory records "
            "were produced."
        )

    history_key = write_inventory(
        records=all_records,
        collection_time=collection_time
    )

    total_errors = sum(
        1
        for item in all_records
        if item.get(
            "collection_error"
        )
    )

    return {
        "statusCode": 200,
        "message": (
            "KMS inventory collection "
            "completed."
        ),
        "snapshot_time": snapshot_time,
        "bucket": CENTRAL_BUCKET,
        "current_object": (
            CURRENT_OBJECT_KEY
        ),
        "history_object": history_key,
        "account_count": len(
            TARGET_ACCOUNTS
        ),
        "inventory_record_count": len(
            all_records
        ),
        "collection_error_count": (
            total_errors
        ),
        "accounts": account_summaries
    }
