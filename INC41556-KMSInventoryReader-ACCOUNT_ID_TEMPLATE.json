{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadKmsInventoryMetadata",
      "Effect": "Allow",
      "Action": [
        "kms:ListKeys",
        "kms:ListAliases",
        "kms:DescribeKey",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DiscoverEnabledRegionsAndIdentity",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeRegions",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}