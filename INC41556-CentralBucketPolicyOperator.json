{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageOnlyCentralBucketPolicy",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:GetBucketLocation",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::clsa-aws-cloudtrail-381492218357"
    },
    {
      "Sid": "ListCentralBucketForValidation",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::clsa-aws-cloudtrail-381492218357"
    }
  ]
}